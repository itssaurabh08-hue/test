# ---------------------------------------------------------------------------
# WhatsApp Bulk Messaging Platform — environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL / Prisma) -----------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_bulk?schema=public"

# --- Redis (BullMQ queue) ----------------------------------------------------
REDIS_URL="redis://localhost:6379"

# --- App auth -----------------------------------------------------------------
# Random 32+ byte secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"
# Base URL the app is served from (used for cookie/webhook URL construction).
APP_URL="http://localhost:3000"

# --- Initial admin user (used only by `pnpm db:seed`) ------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-immediately"
ADMIN_NAME="Admin"

# --- Meta WhatsApp Cloud API ---------------------------------------------------
# See docs/META_SETUP.md for a full step-by-step guide to obtaining these.
META_ACCESS_TOKEN=""
META_WABA_ID=""
META_PHONE_NUMBER_ID=""
META_APP_ID=""
META_APP_SECRET=""
# Verify token you choose yourself and enter in the Meta App webhook config.
META_VERIFY_TOKEN=""
# Meta Graph API version to call, e.g. "v23.0". Meta releases a new version
# roughly every few months and deprecates old ones ~2 years after release.
# IMPORTANT: verify the current version at
# https://developers.facebook.com/docs/graph-api/changelog before deploying,
# and update this value periodically — do not assume the default below is
# still current at the time you read this.
META_GRAPH_API_VERSION="v23.0"

# --- Development / mock mode ---------------------------------------------------
# When "true", no real requests are made to Meta's API. Sends are simulated
# (queued -> sent -> delivered -> read, or occasionally failed) so you can
# develop and test the full flow without a live WABA. The UI displays a
# persistent "DEVELOPMENT / MOCK MODE" banner whenever this is on.
WHATSAPP_MOCK_MODE="true"

# --- Rate limiting / retry (bulk sender) ---------------------------------------
MAX_MESSAGES_PER_SECOND="10"
MAX_CONCURRENT_JOBS="5"
RETRY_ATTEMPTS="3"

# --- File upload limits ---------------------------------------------------------
MAX_UPLOAD_FILE_SIZE_MB="10"

# --- Default country code for phone normalisation --------------------------------
DEFAULT_COUNTRY_CODE="IN"
